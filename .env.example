# Convective Activity Risk System environment
# Copy to .env and adjust. Everything here has a working default.
#
# There is deliberately no HOST_IP setting. The browser derives API URLs from
# whatever hostname it was loaded with, so the machine can move between networks
# and pick up a new DHCP address without a rebuild.

# ---------------------------------------------------------------- project
COMPOSE_PROJECT_NAME=cloud-burst-dev
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Karachi

# ---------------------------------------------------------------- database
# Postgres listens on 5545 inside the container as well as outside, so the
# number is the same everywhere. A native PostgreSQL already holds 5432 on this
# machine, which is why the host port was never going to be 5432.
POSTGRES_DB=cari
POSTGRES_USER=cbd_user
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=cbd-db
POSTGRES_PORT=5545
POSTGRES_HOST_PORT=5545
DATABASE_URL=postgresql://cbd_user:postgres@cbd-db:5545/cari

# Pool sizing, per service
PG_POOL_MIN=2
PG_POOL_MAX=10

# ---------------------------------------------------------------- ports
# Backend range is 3090 to 3099. Frontend range is 4090 to 4099.
GATEWAY_PORT=3090
API_PORT=3091
TILES_PORT=3092
RASTER_PORT=3093
WEB_PORT=4090
WEB_PROD_PORT=4091

# ---------------------------------------------------------------- gateway
# Upstreams are service names on the compose bridge network, never IPs.
# Internal ports match the host ports one to one.
API_INTERNAL_URL=http://cbd-api:3091
TILES_INTERNAL_URL=http://cbd-tiles:3092
RASTER_INTERNAL_URL=http://cbd-raster:3093

CACHE_DIR=/app/.cache
CACHE_TTL_SECONDS=21600
CACHE_PRUNE_DAYS=10
UPSTREAM_TIMEOUT_MS=180000

# CORS. "reflect" echoes the caller origin back, which is what lets an
# arbitrary LAN IP work without a config change. Set an explicit comma
# separated list to lock it down.
CORS_ORIGINS=reflect

# ---------------------------------------------------------------- backend
GDAL_CACHEMAX=512
GDAL_NUM_THREADS=ALL_CPUS
GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR
CPL_VSIL_CURL_ALLOWED_EXTENSIONS=.tif,.tiff,.vrt,.json
DATA_DIR=/data
COG_DIR=/data/cog
RAW_DIR=/data/raw
MAX_CONCURRENT_JOBS=4

# ---------------------------------------------------------------- frontend
# Optional. Leave blank and the client uses window.location.hostname with the
# port below. Only set VITE_API_BASE when pointing at a remote deployment.
VITE_API_BASE=
VITE_GATEWAY_PORT=3090

# Mapbox basemap token, for the satellite, outdoors, streets, light and dark
# basemaps. Leave blank and the portal draws the open basemap instead and says
# so in the basemap switcher, so the stack runs without it.
#
# This is a public client token: it reaches the browser and is visible to
# anyone who loads the portal. Restrict it by URL in the Mapbox account. It is
# not a data credential and does not make any data source authenticated. See
# .claude/guardrails/security.md.
VITE_MAPBOX_TOKEN=

# ---------------------------------------------------------------- upstreams
#
# Every source here is anonymous HTTP or anonymous S3. No API key, no token, no
# service account, no OAuth. There is deliberately no variable for a credential
# anywhere in this file. If something appears to need one, that is the signal to
# find a different source, not to add the variable.
#
# Google Earth Engine and GeoServer are both ruled out. See OPEN_DATA_SOURCES.md
# for what replaces them and why.

# Weather forecast. NOAA GFS 0.25 degree, the primary source. Carries every
# CARI variable including CAPE and precipitable water.
UPSTREAM_GFS_BASE=https://noaa-gfs-bdp-pds.s3.amazonaws.com
# NOMADS server side subsetting, so an ingest pulls megabytes not gigabytes.
UPSTREAM_GFS_FILTER=https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl
GFS_CYCLE_HOURS=6

# ECMWF open subset, secondary. Confirm CAPE and pressure level vertical
# velocity are in the open stream before relying on it.
UPSTREAM_ECMWF_OPENDATA=https://data.ecmwf.int/forecasts

# Terrain. Copernicus DEM GLO-30, already COG, anonymous S3.
UPSTREAM_DEM_BASE=https://copernicus-dem-30m.s3.amazonaws.com

# Pakistan bounding box for source side clipping. Turns a global GRIB into a
# few megabytes.
AOI_WEST=59
AOI_SOUTH=22
AOI_EAST=79
AOI_NORTH=38

# PMD radar and advisories. Already plain HTTP with no auth. Blank means not
# wired yet and the route returns 501 rather than guessing. The radar base is the
# jbirds application root; the gateway lists its per-product directories to find
# the newest frame and proxies the image, so the browser never leaves this stack.
UPSTREAM_PMD_RADAR_BASE=https://radar.weather.gov.pk/jbirds
# The press-release list root; the gateway reads the newest RAIN-WIND release,
# matches its districts and returns them per province for the High-Alert overlay.
UPSTREAM_PMD_PRESS_BASE=https://weather.gov.pk/nwfc/all-press-releases

# ---------------------------------------------------------------- PMD forecast source
#
# THE ONE AUTHENTICATED DATA SOURCE. Read this before adding another.
#
# Everything above is anonymous. This is not: it is the owner's account on the
# PMD early warning portal, which serves the ECMWF, WRF and CFS forecast fields
# the CARI models need and that no anonymous source carries for Pakistan at these
# pressure levels. It was admitted 2026-08-10 as a deliberate, owner-authorised
# exception to the no-authenticated-sources rule, NOT as a precedent. Do not add
# a second data credential by pointing at this one.
#
# Server side only. These never reach the browser, unlike VITE_MAPBOX_TOKEN.
# Leave blank and the PMD ingest is simply unavailable; nothing else is affected.
PMD_BASE=https://115.186.56.181:12304
PMD_USER=
PMD_PASS=
# The portal presents a self-signed certificate. false skips TLS verification for
# this host only. Never widen it to the anonymous upstreams above.
PMD_VERIFY_TLS=false

# Daily automatic forecast ingest.
#
# cbd-api runs the PMD ingest once a day so the timeline advances on its own, and
# once at startup if the newest ingested cycle is not already today's (so a stale
# stack catches up on boot). Entirely idle unless PMD_* above is configured.
INGEST_SCHEDULE_ENABLED=true
# Local (Pakistan, UTC+5) hour of the daily run. 06:00 PKT picks up the day's
# cycle once the portal has published it.
INGEST_SCHEDULE_HOUR_PKT=6
INGEST_CATCHUP_ON_START=true
# Restrict the run to one model (e.g. GRAPES), or blank for every contract model.
INGEST_MODEL=
