        { "color": "#90ee90", "value": "6" },
        { "color": "#0000ff", "value": "4" },
        { "color": "#0097ff", "value": "2.5" },
        { "color": "#66d4fb", "value": "1.5" },
        { "color": "#b2e9fd", "value": "0.5" },
        { "color": "#e6e6fa", "value": "0.2" }
      ]
    }
  }
}
