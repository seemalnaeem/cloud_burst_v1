{
  "$comment": "Band catalog. min and max drive both the tile rescale and the legend ticks, so they cannot drift apart. palette resolves against palettes.json. derivedFrom means the band is computed at ingest, not read raw from the source.",
  "version": 1,
  "categories": [
    { "key": "rainfall",    "label": "Rainfall",         "accent": "#dc2626" },
    { "key": "moisture",    "label": "Moisture",         "accent": "#2563eb" },
    { "key": "instability", "label": "Instability",      "accent": "#d97706" },
    { "key": "dynamics",    "label": "Dynamic Lifting",  "accent": "#554570" },
    { "key": "orographic",  "label": "Orographic",       "accent": "#059669" }
  ],
  "bands": [
    {
      "key": "total_precipitation_sfc",
      "label": "Total Precipitation",
      "unit": "m",
      "category": "rainfall",
      "cumulative": true,
      "internal": true,
      "$comment": "Cumulative since initialization. Never display this directly, difference it into the hourly band."
    },
    {
      "key": "total_precipitation_sfc_hourly",
      "label": "Rainfall",
      "unit": "mm",
      "category": "rainfall",
      "min": 0,
      "max": 100,
      "palette": "rainfall",
      "legendTitle": "Hourly Precipitation (mm)",
      "derivedFrom": {
        "op": "rate",
        "source": "total_precipitation_sfc",
        "formula": "(current - previous) * 1000 / interval_hours",
        "maskBelowOrEqual": 0
      }
    },
    {
      "key": "total_column_water_vapour_sfc",
      "label": "PWAT",
      "unit": "kg/m2",
      "category": "moisture",
      "min": 0, "max": 60,
      "palette": "continuous",
      "legendTitle": "PWAT (kg/m2)"
    },
    {
      "key": "relative_humidity_pl700",
      "label": "RH 700 hPa",
      "unit": "%",
      "category": "moisture",
      "min": 0, "max": 100,
      "clamp": [0, 100],
      "palette": "continuous",
      "legendTitle": "Relative Humidity 700hPa (%)"
    },
    {
      "key": "relative_humidity_pl500",
      "label": "RH 500 hPa",
      "unit": "%",
      "category": "moisture",
      "min": 0, "max": 100,
      "clamp": [0, 100],
      "palette": "continuous",
      "legendTitle": "Relative Humidity 500hPa (%)"
    },
    {
      "key": "dewpoint_temperature_2m_sfc",
      "label": "Dew Point 2m",
      "unit": "degC",
      "category": "moisture",
      "min": -10, "max": 30,
      "palette": "continuous",
      "legendTitle": "Dewpoint Temperature 2m (degC)"
    },
    {
      "key": "most_unstable_cape_sfc",
      "label": "CAPE",
      "unit": "J/kg",
      "category": "instability",
      "min": 0, "max": 4000,
      "palette": "continuous",
      "legendTitle": "CAPE (J/kg)"
    },
    {
      "key": "temperature_2m_sfc",
      "label": "Temperature 2m",
      "unit": "degC",
      "category": "instability",
      "min": -10, "max": 50,
      "palette": "continuous",
      "legendTitle": "Temperature 2m (degC)"
    },
    {
      "key": "temperature_pl850",
      "label": "Temperature 850 hPa",
      "unit": "degC",
      "category": "instability",
      "min": -20, "max": 35,
      "palette": "continuous",
      "legendTitle": "Temperature 850hPa (degC)"
    },
    {
      "key": "vertical_velocity_pl500",
      "label": "Vert. Velocity 500 hPa",
      "unit": "Pa/s",
      "category": "dynamics",
      "min": -2, "max": 2,
      "palette": "continuous",
      "legendTitle": "Vertical Velocity 500hPa (Pa/s)",
      "$comment": "Negative is upward motion. Reduces with min."
    },
    {
      "key": "vertical_velocity_pl700",
      "label": "Vert. Velocity 700 hPa",
      "unit": "Pa/s",
      "category": "dynamics",
      "min": -2, "max": 2,
      "palette": "continuous",
      "legendTitle": "Vertical Velocity 700hPa (Pa/s)",
      "$comment": "Negative is upward motion. Reduces with min."
    },
    {
      "key": "wind_speed_pl850",
      "label": "Wind Speed 850 hPa",
      "unit": "km/hr",
      "category": "dynamics",
      "min": 0, "max": 100,
      "palette": "continuous",
      "legendTitle": "Wind Speed 850hPa (km/hr)",
      "derivedFrom": {
        "op": "magnitude",
        "sources": ["u_component_of_wind_pl850", "v_component_of_wind_pl850"],
        "formula": "sqrt(u^2 + v^2) * 3.6"
      }
    },
    {
      "key": "precipitation_type_sfc",
      "label": "Precipitation Type",
      "unit": "code",
      "category": "rainfall",
      "min": 0, "max": 12,
      "categorical": true,
      "resampling": "nearest",
      "palette": "precipType",
      "legendTitle": "Precipitation Type"
    },
    {
      "key": "elevation",
      "label": "Elevation",
      "unit": "m",
      "category": "orographic",
      "static": true,
      "min": 0, "max": 5000,
      "palette": "elevation",
      "legendTitle": "Elevation (m)"
    },
    {
      "key": "slope",
      "label": "Slope",
      "unit": "deg",
      "category": "orographic",
      "static": true,
      "min": 0, "max": 45,
      "palette": "slope",
      "legendTitle": "Slope (deg)",
      "derivedFrom": {
        "op": "gdaldem_slope",
        "source": "elevation",
        "$comment": "gdaldem slope -compute_edges -s 111120, the scale factor is required for a geographic DEM. This native grid is for display and for the per pixel CARI raster. Scoring uses slope_5km, which is a different number."
      }
    },
    {
      "key": "elevation_5km",
      "label": "Elevation, 5 km",
      "unit": "m",
      "category": "orographic",
      "static": true,
      "internal": true,
      "min": 0, "max": 5000,
      "palette": "elevation",
      "legendTitle": "Elevation (m)",
      "$comment": "Scoring input, not a map layer. Reduced from the native DEM with a max reducer so a district's highest cell drives its terrain conditions, which is what the legacy models do.",
      "derivedFrom": {
        "op": "gdalwarp_max",
        "source": "elevation",
        "resolutionDeg": 0.0449
      }
    },
    {
      "key": "slope_5km",
      "label": "Slope, 5 km",
      "unit": "deg",
      "category": "orographic",
      "static": true,
      "internal": true,
      "min": 0, "max": 45,
      "palette": "slope",
      "legendTitle": "Slope (deg)",
      "$comment": "Scoring input, not a map layer. Derived FROM elevation_5km, never from the native DEM. Slope over a 5 km run is far gentler than over 30 m, and both boolean models test slope at 15 degrees, so deriving it natively would fire the slope condition across every mountain district. See .claude/memory/slope-is-computed-at-5km.md.",
      "derivedFrom": {
        "op": "gdaldem_slope",
        "source": "elevation_5km"
      }
    },
    {
      "$pmdComment": "PMD forecast bands. These are temporal: catalogued per cycle and per lead, so a tile request carries creation_time and lead. They come from the PMD portal, the one authenticated source, and are all surface level. The pressure level bands above (relative_humidity_pl700, vertical_velocity_pl500, and the rest) are the CARI inputs and are NOT what these are; PMD does not serve them for this account. min and max are display ranges judged against the measured data, unit matches what the PMD legend declares.",
      "key": "pmd_cape",
      "label": "CAPE",
      "unit": "J/kg",
      "category": "instability",
      "temporal": true,
      "min": 0, "max": 4000,
      "palette": "plasma",
      "legendTitle": "CAPE (J/kg)"
    },
    {
      "key": "pmd_pwat",
      "label": "Precipitable Water",
      "unit": "kg/m2",
      "category": "moisture",
      "temporal": true,
      "min": 0, "max": 70,
      "palette": "viridis",
      "legendTitle": "Precipitable Water (kg/m2)"
    },
    {
      "key": "pmd_dpt",
      "label": "Dew Point",
      "unit": "C",
      "category": "moisture",
      "temporal": true,
      "min": -10, "max": 30,
      "palette": "continuous",
      "legendTitle": "Dew Point (C)"
    },
    {
      "key": "pmd_rhu",
      "label": "Relative Humidity",
      "unit": "%",
      "category": "moisture",
      "temporal": true,
      "min": 0, "max": 100,
      "palette": "continuous",
      "legendTitle": "Relative Humidity (%)"
    },
    {
      "key": "pmd_tem",
      "label": "Temperature",
      "unit": "C",
      "category": "instability",
      "temporal": true,
      "min": -10, "max": 45,
      "palette": "plasma",
      "legendTitle": "Temperature (C)"
    },
    {
      "key": "pmd_tpe",
      "label": "Total Precipitation",
      "unit": "mm",
      "category": "rainfall",
      "temporal": true,
      "min": 0, "max": 100,
      "palette": "rainfall",
      "legendTitle": "Total Precipitation (mm)"
    },
    {
      "$pmdLevelComment": "Second wave of PMD bands, added once the model endpoint was found to serve pressure levels. HOURTPE is precipitation over the single step, not cumulative, so it needs no differencing. The _pl700, _pl500 and _pl850 bands are the pressure level fields the CARI model actually wants: PMD serves RH at 700 and 500 and temperature at 850 through the level parameter, which the surface-only feed did not. Vertical velocity and wind at level are still absent, so CARI is closer but not complete.",
      "key": "pmd_hourtpe",
      "label": "Hourly Precipitation",
      "unit": "mm",
      "category": "rainfall",
      "temporal": true,
      "min": 0, "max": 50,
      "palette": "rainfall",
      "legendTitle": "Hourly Precipitation (mm)"
    },
    {
      "key": "pmd_rhu_700",
      "label": "Relative Humidity 700 hPa",
      "unit": "%",
      "category": "moisture",
      "temporal": true,
      "min": 0, "max": 100,
      "palette": "continuous",
      "legendTitle": "Relative Humidity 700hPa (%)"
    },
    {
      "key": "pmd_rhu_500",
      "label": "Relative Humidity 500 hPa",
      "unit": "%",
      "category": "moisture",
      "temporal": true,
      "min": 0, "max": 100,
      "palette": "continuous",
      "legendTitle": "Relative Humidity 500hPa (%)"
    },
    {
      "key": "pmd_tem_850",
      "label": "Temperature 850 hPa",
      "unit": "C",
      "category": "instability",
      "temporal": true,
      "min": -20, "max": 30,
      "palette": "plasma",
      "legendTitle": "Temperature 850hPa (C)"
    },
    {
      "$gfsWindComment": "GFS u and v wind components at 850 hPa, kept internal. They are not map layers; they exist so the wind-field endpoint can recover direction for the barb overlay, which needs the vectors, not just the wind_speed_pl850 magnitude. Ingested by scripts/ingest/ingest_gfs.py under model GFS.",
      "key": "wind_u_pl850",
      "label": "Wind U 850 hPa",
      "unit": "m/s",
      "category": "dynamics",
      "temporal": true,
      "internal": true,
      "min": -60, "max": 60,
      "palette": "continuous",
      "legendTitle": "Wind U 850hPa (m/s)"
    },
    {
      "key": "wind_v_pl850",
      "label": "Wind V 850 hPa",
      "unit": "m/s",
      "category": "dynamics",
      "temporal": true,
      "internal": true,
      "min": -60, "max": 60,
      "palette": "continuous",
      "legendTitle": "Wind V 850hPa (m/s)"
    }
  ]
}
